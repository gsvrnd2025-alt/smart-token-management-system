# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Admin Credentials (Change these immediately after deployment)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@example.com

# Token System Settings
STARTING_TOKEN_NUMBER=1
AVERAGE_SERVICE_TIME=10
ORGANIZATION_NAME=Smart Token Management System

# Email Configuration (Optional)
EMAIL_PROVIDER=demo
# For Resend provider:
# RESEND_API_KEY=your-resend-key
# RESEND_SENDER=noreply@yourdomain.com
# For SMTP provider:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_SENDER=noreply@yourdomain.com
# SMTP_SSL=true
